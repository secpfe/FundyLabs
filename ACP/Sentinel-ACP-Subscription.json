{
    "if": {
        "not": {
            "anyOf": [
                {
                    "allOf": [
                        {
                            "field": "type",
                            "equals": "Microsoft.OperationalInsights/workspaces"
                        },
                        {
                            "field": "name",
                            "like": "CyberSOCWS*"
                        },
                        {
                            "field": "id",
                            "contains": "/resourceGroups/CyberSOC/"
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "field": "type",
                            "equals": "Microsoft.Web/serverFarms"
                        },
                        {
                            "field": "name",
                            "equals": "ASP-CyberSOC-b341"
                        },
                        {
                            "field": "id",
                            "contains": "/resourceGroups/ITOperations/"
                        },
                        {
                            "field": "Microsoft.Web/serverfarms/sku.name",
                            "equals": "P0V4"
                        },
                        {
                            "field": "Microsoft.Web/serverfarms/sku.capacity",
                            "lessOrEquals": 1
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "field": "type",
                            "equals": "Microsoft.Web/sites"
                        },
                        {
                            "field": "name",
                            "like": "myVulWebApp-*"
                        }                       
                    ]
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Web/connections"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Logic/workflows"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.OperationsManagement/solutions"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Insights/workbooks"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Insights/dataCollectionRules"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Compute/virtualMachines/extensions"
                }
            ]
        }
    },
    "then": {
        "effect": "Deny"
    }
}