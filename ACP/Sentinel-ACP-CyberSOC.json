{
    "if": {
        "not": {
            "anyOf": [
                {
                    "allOf": [
                        {
                            "field": "type",
                            "equals": "Microsoft.OperationalInsights/workspaces"
                        },
                        {
                            "field": "name",
                            "like": "CyberSOCWS*"
                        },
                        {
                            "field": "id",
                            "contains": "/resourceGroups/CyberSOC/"
                        }
                    ]
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Web/connections"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Logic/workflows"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.OperationsManagement/solutions"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Insights/workbooks"
                },
                {
                    "field": "type",
                    "equals": "Microsoft.Insights/dataCollectionRules"
                }
            ]
        }
    },
    "then": {
        "effect": "Deny"
    }
}