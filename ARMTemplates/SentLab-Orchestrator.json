      },
      {
        "type": "Microsoft.Automation/automationAccounts/schedules",
        "apiVersion": "2015-10-31",
        "name": "[concat(parameters('accountName'), '/HourlySchedule')]",
        "properties": {
          "description": "Runs every hour",
          "startTime": "[parameters('startTime')]",
          "interval": 1,
          "frequency": "Hour"
        },
        "dependsOn": [
          "[resourceId('Microsoft.Automation/automationAccounts', parameters('accountName'))]"
        ]
      },
      {
        "type": "Microsoft.Automation/automationAccounts/jobSchedules",
        "apiVersion": "2023-11-01",
        "name": "[concat(parameters('accountName'), '/', parameters('randomGuid'))]",
        "dependsOn": [
            "[resourceId('Microsoft.Automation/automationAccounts', parameters('accountName'))]",
             "[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('accountName'), 'HourlySchedule')]",
             "[resourceId('Microsoft.Automation/automationAccounts/runbooks', parameters('accountName'),'SimulateTraffic')]"
          ],
        "properties": {
            "runbook": {
                "name": "SimulateTraffic"
            },
            "schedule": {
                "name": "HourlySchedule"
            }
        }
